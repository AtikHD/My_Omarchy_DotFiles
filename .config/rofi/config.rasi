configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
}

* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    fg-alt: #a6adc8;
    accent: #cba6f7;

    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 600px;
    border: 2px;
    border-color: @accent;
    border-radius: 18px;
    background-color: @bg;
    padding: 25px;
}

mainbox {
    spacing: 15px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 16px;
    border-radius: 12px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0 10px 0 0;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @fg-alt;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 10px 14px;
    border-radius: 10px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 28px;
    margin: 0 12px 0 0;
}

element-text {
    vertical-align: 0.5;
}
